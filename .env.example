# ─────────────────────────────────────────────────────────────────────────────
# Labarile Agents — variables d'environnement
# Copier ce fichier en .env.local (jamais commité) ET les mettre dans Vercel
# (Project → Settings → Environment Variables). Ne jamais les coller dans un chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Accès au tableau de bord ────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── Supabase (Settings → API) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (console.anthropic.com → API Keys) ────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram (@BotFather) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Groupe « Labarile – Validation » (Luc) : brouillons à valider, alertes
TELEGRAM_VALIDATION_CHAT_ID=
# Groupe « Labarile – Setting » (setters) : numéros de téléphone à rappeler
TELEGRAM_SETTING_CHAT_ID=

# ── Instagram DM (PlugKit) ──────────────────────────────────────────────────
PLUGKIT_API_KEY=
PLUGKIT_ACCOUNT_ID=

# ── Instagram stories (Meta Graph API) ──────────────────────────────────────
META_IG_USER_ID=
META_ACCESS_TOKEN=
# graph.instagram.com (connexion Instagram) ou graph.facebook.com (connexion Facebook)
META_GRAPH_HOST=graph.instagram.com
META_GRAPH_VERSION=v23.0

# ── Boîte mail commerciale (agent MAIL) ─────────────────────────────────────
# Gmail : imap.gmail.com / 993 et smtp.gmail.com / 465 + « mot de passe d'application »
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Labarile English

# ── Boîte mail support (agent SUPPORT) ──────────────────────────────────────
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_PORT=993
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=465
SUPPORT_USER=
SUPPORT_PASSWORD=
SUPPORT_FROM_NAME=Labarile English – Support

# ── Modèle Claude (laisser par défaut) ──────────────────────────────────────
CLAUDE_MODEL=claude-opus-5-5
